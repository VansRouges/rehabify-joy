# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL — Railway injects DATABASE_URL (internal); use DATABASE_PUBLIC_URL for local dev
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/railway
DATABASE_PUBLIC_URL=postgresql://user:password@shortline.proxy.rlwy.net:12345/railway

# Redis (Railway provides REDIS_URL automatically)
REDIS_URL=redis://localhost:6379/0

# Object storage — use Railway's native names via variable references:
# BUCKET=${{User Audio files.BUCKET}}
# ACCESS_KEY_ID=${{User Audio files.ACCESS_KEY_ID}}
# SECRET_ACCESS_KEY=${{User Audio files.SECRET_ACCESS_KEY}}
# ENDPOINT=${{User Audio files.ENDPOINT}}
# REGION=${{User Audio files.REGION}}
#
# Or our aliases (also supported):
BUCKET_NAME=your-bucket-s3-api-name
BUCKET_ACCESS_KEY=your-access-key
BUCKET_SECRET_KEY=your-secret-key
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=86400
MAX_HISTORY_TURNS=15
MAX_VOICE_SECONDS=60

# Set true only when you explicitly want auto table sync on server start (default: false)
SYNC_DB_ON_STARTUP=false
