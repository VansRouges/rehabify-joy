# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_PUBLIC_URL=
DATABASE_URL=

# Redis (Railway provides REDIS_URL automatically)
REDIS_URL=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=86400
MAX_HISTORY_TURNS=15
MAX_VOICE_SECONDS=60

# Set true only when you explicitly want auto table sync on server start (default: false)
SYNC_DB_ON_STARTUP=false

# Object storage (Railway bucket — S3-compatible)
BUCKET_NAME=your-bucket-name
BUCKET_ACCESS_KEY=your-access-key
BUCKET_SECRET_KEY=your-secret-key
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto
